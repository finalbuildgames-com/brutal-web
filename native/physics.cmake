# Public physics dependencies, matched to BRUTAL's generated API revision.
foreach(flag JPH_USE_DX12 JPH_USE_VK JPH_USE_MTL DEBUG_RENDERER_IN_DEBUG_AND_RELEASE PROFILER_IN_DEBUG_AND_RELEASE)
 set(${flag} OFF CACHE BOOL "" FORCE)
endforeach()
set(JPH_BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(OVERRIDE_CXX_FLAGS OFF CACHE BOOL "" FORCE)
set(INTERPROCEDURAL_OPTIMIZATION OFF CACHE BOOL "" FORCE)
set(GENERATE_DEBUG_SYMBOLS OFF CACHE BOOL "" FORCE)
set(ENABLE_ALL_WARNINGS OFF CACHE BOOL "" FORCE)
set(ENABLE_INSTALL OFF CACHE BOOL "" FORCE)
set(FLOATING_POINT_EXCEPTIONS_ENABLED OFF CACHE BOOL "" FORCE)
foreach(flag USE_SSE4_1 USE_SSE4_2 USE_AVX USE_AVX2 USE_AVX512 USE_LZCNT USE_TZCNT USE_F16C USE_FMADD)
 set(${flag} OFF CACHE BOOL "" FORCE)
endforeach()
set(CPP_EXCEPTIONS_ENABLED ON CACHE BOOL "" FORCE)
set(CPP_RTTI_ENABLED ON CACHE BOOL "" FORCE)
set(CROSS_PLATFORM_DETERMINISTIC ON CACHE BOOL "" FORCE)
add_subdirectory("${JOLT_SOURCE}/Build" jolt-core EXCLUDE_FROM_ALL)
add_subdirectory("${BOX2D_SOURCE}" box2d-core EXCLUDE_FROM_ALL)
if(EMSCRIPTEN)
 add_library(brutal_jolt STATIC jolt_bridge.cpp)
 add_library(brutal_box2d STATIC box2d_bridge.c)
 set_target_properties(brutal_jolt brutal_box2d PROPERTIES PREFIX "")
else()
 add_library(brutal_jolt SHARED jolt_bridge.cpp)
 add_library(brutal_box2d SHARED box2d_bridge.c)
 set_target_properties(brutal_jolt PROPERTIES OUTPUT_NAME jolt)
 set_target_properties(brutal_box2d PROPERTIES OUTPUT_NAME box2d)
endif()
target_link_libraries(brutal_jolt PRIVATE Jolt)
target_link_libraries(brutal_box2d PRIVATE box2d)
add_custom_target(brutal_physics DEPENDS brutal_jolt brutal_box2d)
